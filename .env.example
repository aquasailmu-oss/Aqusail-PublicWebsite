# Public (anon) Supabase client. When these are unset the site renders from the
# seed catalogue in src/lib/seed.ts and enquiries are logged locally instead of saved.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin, used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Salt for hashing visitor IPs before rate limiting. Never expose.
ENQUIRY_IP_SALT=change-me

# Server-only. Reception notification email via Resend. Optional in development.
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=aquasail.mu@gmail.com
ENQUIRY_NOTIFY_FROM=AquaSail Website <website@example.com>
ADMIN_BASE_URL=
